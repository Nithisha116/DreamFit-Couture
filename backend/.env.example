# =============================================================================
# DreamFit Couture — Backend Environment Template
# =============================================================================
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# NEVER commit `.env`. It is gitignored — keep it that way.
# Real credentials belong only in your local `.env` or your host's
# environment-variable settings (Render / Vercel dashboard, etc.).
# =============================================================================

# ---------- Core ----------
PORT=5000
NODE_ENV=development

# ---------- Database ----------
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dreamfit?appName=Cluster0
# Local:  mongodb://127.0.0.1:27017/dreamfit
MONGO_URI=

# ---------- Auth ----------
# Generate a strong random secret, do NOT use a guessable phrase:
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---------- URLs ----------
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Used by the client build only (Vite). Points at the deployed API in production.
VITE_API_URL=http://localhost:5000

# ---------- Cloudflare R2 (object storage) ----------
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ---------- Twilio (WhatsApp notifications) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# ---------- Internal admin seed (optional) ----------
# Consumed by `npm run seed:internal-admin`. If the password is left blank the
# seed script generates one and prints it once.
INTERNAL_ADMIN_EMAIL=
INTERNAL_ADMIN_PASSWORD=
INTERNAL_ADMIN_PHONE=
